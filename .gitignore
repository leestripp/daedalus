# Root .gitignore — daedalus monorepo (library in daedalus/, hosts in icarus/ + monkeybyte/)

# Agent runtime state (daedalus agents) — never commit
.daedalus/
.daedalus-*/
.agents/
.codemax/
.codemax-*/
prompt.txt
Testing/

# Build trees (root-level superbuild + any stray per-host trees)
build/
build-*/
out/
dist/

# Compiled artifacts
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.lib
*.pdb
*.exp
*.ilk

# Tooling
compile_commands.json
.cxx/
graphify-out/

# OS cruft
.DS_Store
Thumbs.db
desktop.ini
