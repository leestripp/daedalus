{
    "_comment": "Example CodeMax settings.json. Copy to ~/.codemax/settings/settings.json and fill in your real keys. The canonical key for Serper.dev web search is now 'serper-search' (the legacy 'serper' is still accepted by the SearchTool for backward compatibility).",

    "auto_approve": false,
    "default_model": "minimax-m3",
    "max_agent_iterations": 600,
    "max_request_size": 4000000,
    "max_response_size": 5000000,
    "max_tool_result_size": 500000,

    "models": {
        "minimax-m3": {
            "host": "https://api.minimax.io",
            "api_key": "YOUR_MINIMAX_API_KEY",
            "model": "MiniMax-M3",
            "max_context_size": 500000,
            "endpoints": {
                "chat": "/v1/chat/completions"
            }
        },
        "minimax-m2.7": {
            "host": "https://api.minimax.io",
            "api_key": "YOUR_MINIMAX_API_KEY",
            "model": "MiniMax-M2.7",
            "max_context_size": 200000,
            "endpoints": {
                "chat": "/v1/chat/completions"
            }
        },
        "lm-studio": {
            "host": "http://localhost:1234",
            "api_key": "lm-studio",
            "model": "llama-3-8b",
            "max_context_size": 32768,
            "endpoints": {
                "chat": "/v1/chat/completions"
            }
        }
    },

    "serper-search": {
        "api_key": "YOUR_SERPER_API_KEY"
    },

    "mcp": {
        "enabled": true,
        "server_command": "uvx minimax-coding-plan-mcp -y",
        "timeout_seconds": 30,
        "tools": [
            "understand_image",
            "web_search"
        ]
    },

    "skills": {
        "enabled": true,
        "directories": [
            ".agents/skills/",
            "~/.codemax/skills/"
        ],
        "max_active_skills": 5,
        "auto_discover": true
    },

    "image": {
        "max_file_size_mb": 10,
        "default_scaling": 256,
        "supported_formats": [
            "jpg", "jpeg", "png", "gif", "webp", "bmp"
        ],
        "remote_timeout_seconds": 30
    },

    "file_io": {
        "credential_patterns": [
            "*.pem", "*.key", "*.crt", "*.p12", "*.pfx",
            "*id_rsa*", "*id_ed25519*", "*id_ecdsa*"
        ]
    }
}