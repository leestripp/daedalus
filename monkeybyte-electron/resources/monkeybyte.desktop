[Desktop Entry]
Type=Application
Version=1.0
Name=MonkeyByte
GenericName=AI Code Editor
Comment=Native desktop AI code editor with an integrated LLM agent
Exec=monkeybyte-electron
Icon=monkeybyte
Terminal=false
Categories=Development;IDE;TextEditor;
Keywords=editor;ide;ai;code;development;
StartupNotify=true
StartupWMClass=io.github.monkeybyte
# GNOME Shell focuses the running instance on a plain left-click of the
# launcher icon (shell policy, not app policy); the app itself is
# G_APPLICATION_NON_UNIQUE so every process is independent. These actions
# give the launcher an explicit "New Window" entry (right-click menu);
# middle-click on the icon also spawns a fresh instance.
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=monkeybyte-electron
