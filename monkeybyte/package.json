{
  "name": "monkeybyte-electron",
  "version": "0.1.0",
  "private": true,
  "description": "MonkeyByte AI code editor \u2014 standalone Electron application",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/run-electron.js",
    "test": "node --test tests/*.test.js",
    "test:smoke": "node scripts/run-electron.js --smoke-test",
    "check": "node scripts/check.js",
    "package": "node scripts/package.js",
    "test:package": "node scripts/package.js --skip-build && node scripts/test-package.js",
    "test:all": "npm test && npm run check && npm run test:smoke && npm run test:package && npm run test:close",
    "test:close": "node scripts/test-close.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "45.3.2"
  }
}
